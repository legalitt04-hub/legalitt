{
  "version": 2,
  "buildCommand": "cd admin-panel && npm install && npm run build",
  "outputDirectory": "admin-panel/dist",
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "https://legalitt-growth.onrender.com/api/v1/$1"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
