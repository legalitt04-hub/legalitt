{
  "version": 3,
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "^/api/v1(?:/(.*))$",
      "dest": "https://legalitt-growth.onrender.com/api/v1/$1",
      "check": true
    },
    {
      "src": "^(?:/((?!api/.*).*))$",
      "dest": "/index.html",
      "check": true
    },
    {
      "src": "^/api/v1/([^/]+)$",
      "dest": "/api/v1/[...path]?...path=$1",
      "check": true
    },
    {
      "src": "^/api(/.*)?$",
      "status": 404
    },
    {
      "handle": "error"
    },
    {
      "status": 404,
      "src": "^(?!/api).*$",
      "dest": "/404.html"
    },
    {
      "handle": "miss"
    },
    {
      "src": "^/api/(.+)(?:\\.(?:js))$",
      "dest": "/api/$1",
      "check": true
    }
  ],
  "crons": []
}
